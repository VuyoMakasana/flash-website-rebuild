# Optional. The site's forms (waitlist, contact, driver/seller applications)
# post to the production Flash-App backend's marketing routes. When this is
# unset they default to https://api.flashdelivery.co.za/api (see
# src/config/api.js). Set it only to point a build at a different backend,
# e.g. a staging Flash-App instance. Note: VITE_* values are inlined into the
# public JS bundle — never put a secret here.
# VITE_API_URL=https://api.flashdelivery.co.za/api
