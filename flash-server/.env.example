PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# Supabase (flash-db project). Server-side only — never put the
# service-role key in flash-app or any VITE_* variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Token for GET /api/admin/export (send as the x-admin-token header).
# At least 32 characters; leave empty to disable the endpoint.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EXPORT_TOKEN=
